# =============================================================================
# CANKORA PMO — Environment Variables Template
# Copy to .env and fill in actual production values.
# NEVER commit .env to git.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.0.0
APP_URL=https://pmo.cankonix.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=cankora
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=cankora_db
DB_SSLMODE=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_SECRET_KEY
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────────────
# Internal service name — do not change unless you rename the redis container
REDIS_URL=redis://cankonix-pmo-redis:6379/0

# ── MinIO / Object Storage ────────────────────────────────────────────────────
# Generate: openssl rand -hex 16
STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
STORAGE_BUCKET_DOCUMENTS=cankora-documents

# ── SMTP (optional — NoopProvider used when empty) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CANKORA PMO <noreply@cankonix.com>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://pmo.cankonix.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# Leave empty so Next.js uses its built-in /api rewrite to the API container
NEXT_PUBLIC_API_URL=
