# =============================================================================
# CANKORA Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
PORT=8080
APP_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL 15) -----------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=cankora
DB_PASSWORD=cankora_secret
DB_NAME=cankora_db
DB_SSLMODE=disable

# ---- Authentication ---------------------------------------------------------
# JWT_SECRET must be at least 32 characters. Use a strong random value in production.
JWT_SECRET=CHANGE_ME_USE_A_STRONG_32_CHAR_SECRET
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# ---- Redis ------------------------------------------------------------------
# Prepared for Phase 2 caching — not active in Phase 1
REDIS_URL=redis://localhost:6379/0

# ---- Object Storage (MinIO) -------------------------------------------------
# Prepared for Phase 2 document uploads — not active in Phase 1
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=cankora-documents
STORAGE_USE_SSL=false

# ---- Local Document Storage (P1-005, Phase 1) --------------------------------
# Phase 1 stores uploaded document files on local disk under the backend CWD.
# The DB row stores a RELATIVE storage key; never an absolute filesystem path.
STORAGE_LOCAL_PATH=storage/documents
# Maximum upload size in bytes (default 20 MB)
STORAGE_MAX_SIZE_BYTES=20971520

# ---- Data validation (P1-012) ----------------------------------------------
# Prevent the submitter from validating their own submission by default.
DATA_VALIDATION_REQUIRE_SOD=true

# ---- SMTP (email notifications) ---------------------------------------------
# Leave SMTP_HOST empty in development to use the NoopProvider (no emails sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CANKORA <noreply@cankora.local>
